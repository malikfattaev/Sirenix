# Copy to .env.local for development; set the same names as service variables
# when deploying. Nothing here is exposed to the browser: every value is read
# on the server only.

# --- Capital.com market data (required) --------------------------------------
# Create a key in Capital.com → Settings → API integrations.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_API_PASSWORD=

# "live" or "demo". Read-only either way: no trading endpoint is reachable.
CAPITAL_ENVIRONMENT=live

# --- First administrator (required on a fresh install) -----------------------
# Created once, only while the user table is empty, and never again — so a
# restart cannot reset anybody's password. Deliberately not a setup page: an
# install that hands the first visitor an admin account is one open port away
# from being someone else's.
ADMIN_LOGIN=
ADMIN_PASSWORD=

# --- Persistent state (optional) ---------------------------------------------
# Signal history and accounts, and the settings the app writes back. Both
# default to ./data next to the project; the Docker image points them at the
# /data volume instead.
# DATABASE_PATH=./data/signals.db
# SETTINGS_PATH=./data/settings.json

# --- Research scripts (optional) ---------------------------------------------
# Where scripts/research/* keep downloaded candles between runs.
# RESEARCH_CACHE_DIR=./data/research-cache
