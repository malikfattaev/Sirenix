# Capital.com API credentials (server-side only, never exposed to the client).
# Create a key in Capital.com → Settings → API integrations.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_API_PASSWORD=

# "live" or "demo"
CAPITAL_ENVIRONMENT=live

# Optional: where the SQLite history file lives (defaults to ./data/signals.db)
# DATABASE_PATH=
